# ==============================================================================
# ServeEase Server Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# MongoDB Connection URI:
# - Local: mongodb://127.0.0.1:27018/serveease
# - Cloud (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/serveease?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27018/serveease

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173
